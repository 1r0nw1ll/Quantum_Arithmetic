#!/usr/bin/env python3
"""
CLI wrapper for collaboration broadcast
Usage: echo '{"event_type": "...", "data": {...}}' | collab_broadcast
   Or: collab_broadcast --event-type "..." --data '{"key": "value"}'
"""

import sys
import json
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "qa_agents" / "cli"))

from qa_agent_base import CollaborativeAgent
try:
    import zmq  # type: ignore
    _ZMQ_AVAILABLE = True
except Exception:
    _ZMQ_AVAILABLE = False

def main():
    parser = argparse.ArgumentParser(description='Broadcast event to collaboration bus')
    parser.add_argument('--event-type', help='Event type')
    parser.add_argument('--data', help='Event data (JSON string)')
    parser.add_argument('--agent-name', default='cli_broadcast', help='Agent name')

    args = parser.parse_args()

    # Read from stdin if no args provided
    if not args.event_type:
        try:
            if not sys.stdin.isatty():
                input_data = json.load(sys.stdin)
                event_type = input_data.get('event_type')
                data = input_data.get('data', {})
            else:
                print(json.dumps({"status": "error", "error": "No input provided"}))
                sys.exit(1)
        except Exception as e:
            print(json.dumps({"status": "error", "error": f"Failed to parse input: {str(e)}"}))
            sys.exit(1)
    else:
        event_type = args.event_type
        try:
            data = json.loads(args.data) if args.data else {}
        except json.JSONDecodeError as e:
            print(json.dumps({"status": "error", "error": f"Invalid JSON in --data: {str(e)}"}))
            sys.exit(1)

    # Connect and broadcast (with graceful fallback when ZMQ not available)
    try:
        # If ZMQ is missing, avoid instantiating CollaborativeAgent to keep stdout clean
        if not _ZMQ_AVAILABLE:
            # Write to local event log for observability
            logs_dir = Path(__file__).parent / "logs"
            logs_dir.mkdir(exist_ok=True)
            evt = {"event_type": event_type, "data": data}
            with open(logs_dir / "collab_events.jsonl", "a") as f:
                f.write(json.dumps(evt) + "\n")

            print(json.dumps({
                "status": "ok",
                "event_type": event_type,
                "broadcasted": True,
                "note": "ZeroMQ unavailable; logged locally"
            }))
            sys.exit(0)

        agent = CollaborativeAgent(args.agent_name, auto_connect=True)

        if not getattr(agent, "connected", False):
            print(json.dumps({"status": "error", "error": "Not connected to bus"}))
            sys.exit(1)

        success = agent.broadcast(event_type, data)

        result = {
            "status": "ok" if success else "error",
            "event_type": event_type,
            "broadcasted": success
        }

        print(json.dumps(result))

        agent.disconnect()
        sys.exit(0 if success else 1)

    except Exception as e:
        print(json.dumps({"status": "error", "error": str(e)}))
        sys.exit(1)

if __name__ == "__main__":
    main()
