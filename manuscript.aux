\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Histogram of $C_{\mathrm  {mod}\,24}$ residues across the ten-class Raman dataset. Distinct clustering is visible for silicon $(0)$, quartz $(6)$, and the $(4)$ superfamily.}}{22}{figure.1}\protected@file@percent }
