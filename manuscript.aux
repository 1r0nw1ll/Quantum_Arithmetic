\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Histogram of $F_{\mathrm  {mod}\,24}$ residues. Silicon $(7)$ and quartz $(16)$ are isolated; the $(4,3)$ superfamily maps to residue $3$.}}{22}{figure.2}\protected@file@percent }
\newlabel{fig:fm24_hist}{{2}{22}{Histogram of $F_{\mathrm {mod}\,24}$ residues. Silicon $(7)$ and quartz $(16)$ are isolated; the $(4,3)$ superfamily maps to residue $3$}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Geometric summary of the Quantum Arithmetic (QA) structure used in this work. Left: the QA right triangle with legs $C=2ed$ and $F=ba$ and hypotenuse $G=e^2+d^2$. Right: the associated QA ellipse with perigee $J=bd$, apogee $K=da$, and focal separation $2X=2ed$, together with the inner ellipse obtained by dividing by $d$. Bottom: modular projections of $C$ and $F$ into $(\bmod  24,\bmod  9)$ residue families used to define QA spectral superfamilies.}}{24}{figure.3}\protected@file@percent }
\newlabel{fig:qa_geometry_overview}{{3}{24}{Geometric summary of the Quantum Arithmetic (QA) structure used in this work. Left: the QA right triangle with legs $C=2ed$ and $F=ba$ and hypotenuse $G=e^2+d^2$. Right: the associated QA ellipse with perigee $J=bd$, apogee $K=da$, and focal separation $2X=2ed$, together with the inner ellipse obtained by dividing by $d$. Bottom: modular projections of $C$ and $F$ into $(\bmod 24,\bmod 9)$ residue families used to define QA spectral superfamilies}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Composite QA Raman benchmark: (top-left) ablation summary (centroid and kNN accuracies), (top-right) per-class accuracy (kNN weighted), (bottom-left) confusion matrix for the ten-class Raman corpus, (bottom-right) mod-24 histograms for frequent classes.}}{24}{figure.4}\protected@file@percent }
\newlabel{fig:benchmark}{{4}{24}{Composite QA Raman benchmark: (top-left) ablation summary (centroid and kNN accuracies), (top-right) per-class accuracy (kNN weighted), (bottom-left) confusion matrix for the ten-class Raman corpus, (bottom-right) mod-24 histograms for frequent classes}{figure.4}{}}
