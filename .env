# QA Lab Fast-Path Defaults (applied by request)
QA_FP_ENABLE_WHEEL=1
QA_FP_ENABLE_FAMILY=1
QA_FP_FAMILY_TOL=0.05
QA_FP_POS_MIN=0.0

# QE feature weights
QA_QE_CURV_WEIGHT=0.25
QA_QE_IDEAL_WEIGHT=0.0

# Quick ideal E8 gate (0.0 to disable)
QA_FP_IDEAL_MIN=0.20

# E8 strategy (leave auto unless tuning)
# QA_E8_PREFER_NUMPY=0
# QA_E8_DISABLE_RUST=0
# QA_E8_VEC_CHUNK=200000
QA_E8_ROOT_CHUNK=240
# Eval overrides (for metrics loop)
QA_EVAL_N=1200000
QA_EVAL_QE_TOPK=1024
QA_QA_CURV_WEIGHT=0.25
QA_QA_IDEAL_WEIGHT=0.0
