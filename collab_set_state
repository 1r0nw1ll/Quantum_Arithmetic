#!/usr/bin/env python3
"""
CLI wrapper for setting shared state
Usage: echo '{"key": "...", "value": {...}}' | collab_set_state
   Or: collab_set_state --key "..." --value '{"data": "..."}'
"""

import sys
import json
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "qa_agents" / "cli"))

from qa_agent_base import CollaborativeAgent

def main():
    parser = argparse.ArgumentParser(description='Set value in shared state')
    parser.add_argument('--key', help='State key')
    parser.add_argument('--value', help='State value (JSON string)')
    parser.add_argument('--agent-name', default='cli_state', help='Agent name')

    args = parser.parse_args()

    # Read from stdin if no args provided
    if not args.key:
        try:
            input_data = json.load(sys.stdin)
            key = input_data.get('key')
            value = input_data.get('value')
        except:
            print(json.dumps({"status": "error", "error": "No input provided"}))
            sys.exit(1)
    else:
        key = args.key
        value = json.loads(args.value) if args.value else None

    # Connect and set state
    try:
        agent = CollaborativeAgent(args.agent_name, auto_connect=True)

        if not agent.connected:
            print(json.dumps({"status": "error", "error": "Not connected to bus"}))
            sys.exit(1)

        success = agent.set_state(key, value)

        result = {
            "status": "ok" if success else "error",
            "key": key,
            "value": value,
            "updated": success
        }

        print(json.dumps(result))

        agent.disconnect()
        sys.exit(0 if success else 1)

    except Exception as e:
        print(json.dumps({"status": "error", "error": str(e)}))
        sys.exit(1)

if __name__ == "__main__":
    main()
